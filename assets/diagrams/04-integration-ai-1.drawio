<mxCell id="legend" value="&lt;b&gt;Steps&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;Data Map / Info Protection / DSPM / Audit log&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The four internal components everything connects to.&lt;br&gt;&lt;br&gt;2. &lt;b&gt;&lt;font color=&quot;#d79b00&quot;&gt;AWS S3&lt;/font&gt;&lt;/b&gt;&lt;br&gt;AWS IR + Role ARN. Not supported in Azure Government.&lt;br&gt;&lt;br&gt;3. &lt;b&gt;&lt;font color=&quot;#d79b00&quot;&gt;Snowflake&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Key-pair auth (basic auth being retired).&lt;br&gt;&lt;br&gt;4. &lt;b&gt;&lt;font color=&quot;#d79b00&quot;&gt;Salesforce&lt;/font&gt;&lt;/b&gt;&lt;br&gt;REST API via a connected app.&lt;br&gt;&lt;br&gt;5. &lt;b&gt;&lt;font color=&quot;#d79b00&quot;&gt;On-prem file shares&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Bidirectional — scanner can label in place.&lt;br&gt;&lt;br&gt;6. &lt;b&gt;&lt;font color=&quot;#9673a6&quot;&gt;OneTrust&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Arrives indirectly, via Sentinel — not a native connector.&lt;br&gt;&lt;br&gt;7. &lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;SharePoint Online&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Bidirectional with MIP; feeds DSPM for AI directly.&lt;br&gt;&lt;br&gt;8. &lt;b&gt;&lt;font color=&quot;#d6b656&quot;&gt;Copilots and agents&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Every interaction is written to the audit log.&lt;br&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="320" height="680" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
