<mxCell id="legend" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;LABEL_POLICY publishes SENSITIVITY_LABEL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1—N.&lt;br&gt;&lt;br&gt;2. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;SENSITIVITY_LABEL applied to CONTENT_ITEM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;N—N.&lt;br&gt;&lt;br&gt;3. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;SIT detected in CONTENT_ITEM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;N—N. Sensitive info type match.&lt;br&gt;&lt;br&gt;4. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;DATA_SOURCE contains ASSET&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1—N.&lt;br&gt;&lt;br&gt;5. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;SIT classifies ASSET&lt;/font&gt;&lt;/b&gt;&lt;br&gt;N—N.&lt;br&gt;&lt;br&gt;6. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;POLICY uses SIT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;N—N. Policy conditions reference SITs.&lt;br&gt;&lt;br&gt;7. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;AI_INTERACTION emits AUDIT_RECORD&lt;/font&gt;&lt;/b&gt;&lt;br&gt;1—1.&lt;br&gt;&lt;br&gt;8. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;AI_INTERACTION references CONTENT_ITEM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;N—N. Grounding sources.&lt;br&gt;&lt;br&gt;9. &lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;CASE collects AI_INTERACTION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;N—N. eDiscovery / investigations.&lt;br&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=10;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1560" y="140" width="320" height="620" as="geometry"/></mxCell>
